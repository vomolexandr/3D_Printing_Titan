////////////////////////////////MODBUS////////////////////////////////
double k_cor_z = 0.5 //Коефіцієнт корекції по Z
double measure_area = 12.0 //Зона вимірювання напруги для АРНД
double mm_per_v = 1.67 //Коеф. співвідношення 1мм до 1В
double mean_v = 22.0 //середнє значення напруги (для 3мм зазору)
double min_z = 1 //Мінімально допустима координата Z

bool setupstart //Запуск налаштувань при першому старті
modbus_dev m //Модбас
byte redata[2] //Масив читання з модбаса
byte sedata[2] //Масив надсилання модбас
double ArcVoltage = 0.0 //Поділене значення напруги
int Voltage_x100 = 0 //Неподілене значення напруги
double calc_z = 0.0 //Розрахункове значення коорекції

func void setup() //Функція ініціалізації
open(m, "rtserMB0", 10, 9600, 8, one, none) //Ініціалізації модбас
clearbuff (m) //Очистка буфера
endfunc

func void AVCON()
sedata[0] = 1
sedata[1] = 0
waituntil write(m, sedata, 0, 2) //Надсилаэмо модбас
endfunc

func void AVCOFF()
sedata[0] = 0
sedata[1] = 0
waituntil write(m, sedata, 0, 2)
endfunc

func void AVCREAD()
waituntil read(m, redata, 2, 2) //Читаємо модбас
Voltage_x100 = redata[1] * 256 + redata[0]
ArcVoltage = Voltage_x100 / 100.0
print ArcVoltage
endfunc
////////////////////////////////MODBUS////////////////////////////////

stoptype fast

func void inthandler0() // Прерывание по F3
stopmove fast
setdo(1,false)
waittime(40)
setdo (6, FALSE)
pause
startmove 
endfunc

double sl =0
bool o=true
double l=-360+sl//************
double h=0
double h1=1.5
double r=146//radius
double x1=12  //shirina
double spd=12

double s1=3.5
double sr=(360*s1)/(2*3.14*r)
double r_speed=(360*spd)/(2*3.14*r)
pose p1 = { x 0, y 0, z 0, a 179.877, b 0.008, c 179.344, cfg 0, turn 110111b, ej1 0, ej2 0, ej3 9.000e+09, ej4 9.000e+09, ej5 9.000e+09, ej6 9.000e+09 }
speed v1 = { per 5, tcp 12, ori 5, exj 3}
v1.tcp=spd
v1.exj=r_speed
int i =1
int n=0
p1.z=h
p1.y=0
p1.x=0
p1.ej2=sl 
double ssl =0.0
func void main()
interrupt 0, when: getdi(1), do: inthandler0()

////////////////////////////////MODBUS////////////////////////////////
if (setupstart == false) //Якщо функція ініціалізації не була запущена
setup() //Запускаємо функцію ініціалізації
setupstart = true //Флажок, що функція ініціалізації була виконана
endif
////////////////////////////////MODBUS////////////////////////////////

waittime 1
waittime 1
lin p1,v1,$wobj11
p1.x=x1
pause
setdo (6, TRUE)
pause
setdo (1, TRUE)
waittime time:2.4
loop

loop

if(i%2==1)
p1.x=-p1.x
trigger 1, when: S(abs(x1) - measure_area/2), do: AVCON() //MODBUS
trigger 2, when: StoEnd(abs(x1) - measure_area/2), do: AVCOFF() //MODBUS
lin p1,v1,sl:ssl,$wobj11
endif

if(i%2==0)
if (i > 2)
AVCREAD() //MODBUS
if (ArcVoltage > 20 && ArcVoltage < 30)
calc_z = p1.z + (mean_v - ArcVoltage)*mm_per_v*k_cor_z
print calc_z
if (calc_z < h - min_z) //Обмеження по мінімальному Z
calc_z = h - min_z
endif
p1.z = calc_z
endif
endif
v1.exj=(360*spd)/(2*3.14*(r+p1.x))
p1.ej2+=-sr
lin p1,v1,sl:ssl,$wobj11
endif

i++
if(p1.ej2<=l)
i=1
break
endif

endloop
l-=360
h+=h1
p1.z=h

n+=1
if(n==3)
setdo(1,false)
waittime(40)
setdo(6,false)
break
endif
endloop
pause

endfunc